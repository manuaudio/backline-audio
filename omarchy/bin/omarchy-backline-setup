#!/bin/bash

# omarchy:summary=Add or remove Backline's Omarchy menu rows and hotkeys, and check its bar plugin
# omarchy:args=[--yes] [--no-hotkeys] [--no-menu] [--no-plugin] | --uninstall
# omarchy:examples=omarchy backline setup | omarchy backline setup --uninstall

# The parts of Backline's Omarchy integration that live in the user's own
# files, which an Omarchy plugin can't declare:
#
#   plugin    checks that the bar plugin (io.github.manuaudio.backline) is
#             installed, and offers `omarchy plugin add` for it if not
#   menu      Backline's rows, merged into
#             ~/.config/omarchy/extensions/omarchy-menu.jsonc
#   hotkeys   appended to ~/.config/hypr/bindings.lua (asked first); each key
#             is checked against what is already bound on this system, and
#             one that is taken is not bound
#
# The bar panels need Omarchy's Quattro shell and the bar plugin. Without
# them (Omarchy 4.0.4's shell, or --no-plugin), the menu rows and hotkeys that
# would open a panel are left out, and Super + Ctrl + M opens the Backline
# Mixer instead, so no key or row points at something that can't open.
#
# Both edits go between backline markers, and a file is changed only when its
# content would change, after a timestamped backup next to it
# (<file>.bak.backline-<date>-<time>): running this twice changes nothing the
# second time, and --uninstall takes out exactly what was put in, byte for
# byte. Nothing is changed without a yes (or --yes).

set -uo pipefail
source "$(dirname -- "$(readlink -f -- "$0")")/../lib/omarchy-backline.sh"

config=${XDG_CONFIG_HOME:-$HOME/.config}
menu_file=$config/omarchy/extensions/omarchy-menu.jsonc
bindings_file=$config/hypr/bindings.lua
plugin_id=io.github.manuaudio.backline
plugin_url=${BACKLINE_PLUGIN_URL:-https://github.com/manuaudio/backline-audio}
usage="Usage: omarchy-backline-setup [--yes] [--no-hotkeys] [--no-menu] [--no-plugin] | --uninstall"

yes=false
hotkeys=true
menu=true
plugin=true
uninstall=false
for arg in "$@"; do
  case $arg in
    --yes) yes=true ;;
    --no-hotkeys) hotkeys=false ;;
    --no-menu) menu=false ;;
    --no-plugin) plugin=false ;;
    --uninstall) uninstall=true ;;
    -h | --help)
      echo "$usage"
      echo "Adds Backline's Omarchy menu rows and hotkeys (asked first), and checks its bar plugin."
      echo "Each file is backed up before it changes; --uninstall restores it byte for byte."
      exit 0
      ;;
    *) echo "$usage" >&2; exit 2 ;;
  esac
done

have() { command -v "$1" >/dev/null 2>&1; }
edit() { python3 -I "$BL_ROOT/lib/omarchy-backline-setup.py" "$@"; }

confirm() {
  if [[ $yes == "true" ]]; then
    return 0
  elif have gum && [[ -t 0 ]]; then
    gum confirm "$1"
  else
    echo "$1 (skipped: run with --yes to agree)"
    return 1
  fi
}

plugin_installed() {
  [[ -f $config/omarchy/plugins/$plugin_id/manifest.json ]]
}

if [[ $uninstall == "true" ]]; then
  edit strip "$menu_file" "$bindings_file" | grep -v ': unchanged$'
  echo "menu rows and hotkeys: removed"
  if plugin_installed; then
    echo "the bar plugin is still installed; to remove it: omarchy plugin remove $plugin_id"
  fi
  exit 0
fi

if [[ $plugin == "true" ]]; then
  if plugin_installed; then
    echo "bar plugin: $plugin_id is installed (omarchy plugin update $plugin_id to update it)"
  elif ! bl_shell_has_panels; then
    echo "bar plugin: not offered; this Omarchy's shell can't load its panels (they need the Quattro shell)"
  elif have omarchy-plugin-add && confirm "Add Backline's bar plugin from $plugin_url?"; then
    omarchy-plugin-add "$plugin_url" --enable --yes
  else
    echo "bar plugin: not installed; add it with: omarchy plugin add $plugin_url --enable"
  fi
fi

panel_args=()
if bl_panels_available; then
  panel_args=(--panels)
else
  echo "bar panels: not available here, so the menu rows and hotkeys that open them are left out; the Backline Mixer and the commands stand in"
fi

if [[ $menu == "true" ]] && confirm "Add Backline's rows to the Omarchy menu ($menu_file)?"; then
  edit menu "$menu_file" "$BL_ROOT/extensions/omarchy-menu.jsonc" "${panel_args[@]}"
  echo "menu: Super+Space > Trigger > Backline"
fi

if [[ $hotkeys == "true" ]]; then
  echo "hotkeys this would add:"
  edit hotkeys "$bindings_file" "$BL_ROOT/hypr/backline.lua" "${panel_args[@]}" --dry-run | grep '^hotkey ' | sed 's/^hotkey /  /'
  if confirm "Add these hotkeys to $bindings_file?"; then
    edit hotkeys "$bindings_file" "$BL_ROOT/hypr/backline.lua" "${panel_args[@]}" | grep -v '^hotkey '
    echo "hotkeys: Hyprland applies them on its next config reload"
  fi
fi
