#!/bin/bash

# Installs Backline's Omarchy integration from this checkout for the current
# user, with no sudo. With the backline-audio package installed, the same
# comes from `omarchy plugin add https://github.com/manuaudio/backline-audio
# --enable` plus `omarchy-backline-setup`; this is for running from source.
#
#   commands   omarchy-backline-* into ~/.local/bin (linked to a copy under
#              ~/.local/share/backline/omarchy, with their lib and catalogs)
#   plugin     the bar plugin io.github.manuaudio.backline (manifest.json and
#              omarchy/plugin/) into ~/.config/omarchy/plugins/<id>, as
#              Omarchy's "installing by hand" does, then rescanned and enabled
#              through Omarchy's own commands
#   menu,      omarchy-backline-setup: Backline's rows in
#   hotkeys    ~/.config/omarchy/extensions/omarchy-menu.jsonc and its hotkeys
#              in ~/.config/hypr/bindings.lua, between backline markers
#   mixer      backline-mixer and its .desktop entry, if ui/ has been built
#
# Older installs (four plugins, backline.instruments ...) are taken out first.
#
#   omarchy/install [--yes] [--no-hotkeys] [--no-menu]
#   omarchy/install --uninstall

set -uo pipefail

src=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo=$(cd -- "$src/.." && pwd)
data=${XDG_DATA_HOME:-$HOME/.local/share}
config=${XDG_CONFIG_HOME:-$HOME/.config}
share=$data/backline/omarchy
bin=$HOME/.local/bin
plugins_dir=$config/omarchy/plugins
plugin_id=$(jq -r .id "$repo/manifest.json")
old_ids=(backline.instruments backline.plugins backline.record backline.transport)

yes=false
setup_args=(--no-plugin)
uninstall=false
for arg in "$@"; do
  case $arg in
    --yes) yes=true; setup_args+=(--yes) ;;
    --no-hotkeys | --no-menu) setup_args+=("$arg") ;;
    --uninstall) uninstall=true ;;
    *) echo "Usage: omarchy/install [--yes] [--no-hotkeys] [--no-menu] | --uninstall" >&2; exit 2 ;;
  esac
done

have() { command -v "$1" >/dev/null 2>&1; }

remove_plugin() { # id
  have omarchy-plugin-disable && omarchy-plugin-disable "$1" >/dev/null 2>&1
  rm -rf "${plugins_dir:?}/$1"
}

uninstall_all() {
  "$src/bin/omarchy-backline-setup" --uninstall >/dev/null
  for id in "$plugin_id" "${old_ids[@]}"; do remove_plugin "$id"; done
  have omarchy-shell && omarchy-shell -q shell rescanPlugins >/dev/null 2>&1
  for link in "$bin"/omarchy-backline-*; do
    [[ -L $link && $(readlink "$link") == "$share"/* ]] && rm -f "$link"
  done
  rm -rf "$share"
  rm -f "$bin/backline-mixer" "$data/applications/backline-mixer.desktop"
  echo "Backline's Omarchy integration is removed."
}

if [[ $uninstall == "true" ]]; then
  uninstall_all
  exit 0
fi

# Commands, their lib and catalogs.
rm -rf "$share"
mkdir -p "$share" "$bin"
cp -r "$src/bin" "$src/lib" "$src/i18n" "$src/hypr" "$src/extensions" "$share/"
for command in "$share"/bin/omarchy-backline-*; do
  ln -sfn "$command" "$bin/$(basename "$command")"
done
echo "commands: $(ls "$share/bin" | wc -l) in $bin"

# The bar plugin: the manifest and omarchy/plugin/, the files `omarchy plugin
# add` would use from a clone of the repository.
for id in "${old_ids[@]}"; do remove_plugin "$id"; done
rm -rf "${plugins_dir:?}/$plugin_id"
mkdir -p "$plugins_dir/$plugin_id/omarchy"
cp "$repo/manifest.json" "$repo/LICENSE" "$plugins_dir/$plugin_id/"
cp -r "$src/plugin" "$plugins_dir/$plugin_id/omarchy/plugin"
echo "plugin: $plugin_id in $plugins_dir"
if have omarchy-shell; then
  omarchy-shell -q shell rescanPlugins >/dev/null 2>&1
  if have omarchy-plugin-enable; then
    omarchy-plugin-enable "$plugin_id" >/dev/null 2>&1 || echo "  could not enable it; run: omarchy plugin enable $plugin_id"
  fi
fi

"$share/bin/omarchy-backline-setup" "${setup_args[@]}"

if [[ -x $repo/ui/build/backline-mixer ]]; then
  install -Dm755 "$repo/ui/build/backline-mixer" "$bin/backline-mixer"
  install -Dm644 "$repo/ui/pkgbuild/backline-mixer.desktop" "$data/applications/backline-mixer.desktop"
  echo "mixer: $bin/backline-mixer, in the app launcher as Backline Mixer"
else
  echo "mixer: not built; cmake -S ui -B ui/build && cmake --build ui/build, then run this again"
fi
