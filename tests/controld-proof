jq -e '.source == "midi:cc:1:21"' "$out/learn-midi.json" >/dev/null && jq -e '.source == "osc:/learned/play"' "$out/learn-osc.json" >/dev/null &&
  [[ $r_after == true ]] && echo "  RESULT: PASS (the first control moved and the first OSC address sent became mappings that work)" || echo "  RESULT: FAIL"
