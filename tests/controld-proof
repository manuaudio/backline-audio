wait $kp || true
sleep 0.5
a2=$(cprop ActiveProfiles); m2=$(cprop MappingCount)
echo "  restarted with no mappings ($m0); the keyboard appears: ActiveProfiles $a1, mappings $m1; CC 22 = 64 sent: mapping test-ctlkbd.cc.1.22 sends $sends, volume $v0 -> $v1"
echo "  the keyboard goes: ActiveProfiles $a2, mappings $m2; $(grep -c 'profile test-ctlkbd' "$out/controld.log") log lines: $(grep 'profile test-ctlkbd' "$out/controld.log" | sed 's/^backline-controld: //' | tr '\n' ';')"
del=$(busctl --user call "${C[@]}" DeleteProfile s korg-nanokontrol2 2>&1 | sed 's/^Call failed: //')
echo "  deleting a system profile: $del"
ctl DeleteProfile s test-ctlkbd >/dev/null
[[ $n_sys -ge 3 && $(jq -r .source "$out/learn-p.json") == midi:cc:1:22 && $(jq '.bindings | length' "$ppath") == 1 &&
   $m0 == 0 && $a1 == *test-ctlkbd* && $m1 == 1 && $sends -ge 1 && $m2 == 0 && $a2 == "0" && ! -e $ppath ]] &&
  echo "  RESULT: PASS (a learned control saved as a device profile came back by itself when the device appeared, worked, and went with it)" || echo "  RESULT: FAIL"
