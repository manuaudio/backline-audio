########################################################################## 7
if want 7; then
echo; echo "-- 7. security"
ensure_clockd
ctl Map 'ssa{sv}' osc:/sec/count transport:tempo 2 min d 60 max d 180 >/dev/null
st() { echo "Received $(cprop Received), Rejected $(cprop Rejected), AuthFailures $(cprop AuthFailures), Malformed $(cprop Malformed)"; }
bad=()
check() { "$@" || bad+=("$CASE"); }
echo "  counters: $(st)"
maps0=$(cprop MappingCount)
busctl --user call "${K[@]}" Stop
CASE="wrong secret"
r=$(osc tcp 10.77.0.1 "$TCP_PORT" --from 10.77.0.2 --secret wrong-secret-of-enough-length /transport/play)
echo "  TCP, wrong secret: replies $(jq -c .replies <<<"$r"), closed by controld: $(jq .closed_by_server <<<"$r"); $(st)"
check jq -e '.closed_by_server and .replies == [["/backline/auth", 0]]' <<<"$r" >/dev/null
CASE="before auth"
r=$(osc tcp 10.77.0.1 "$TCP_PORT" --from 10.77.0.2 /transport/play); sleep 0.2
echo "  TCP, a mapped message before authenticating: closed by controld: $(jq .closed_by_server <<<"$r"); Rolling $(kprop Rolling)"
check jq -e '.closed_by_server' <<<"$r" >/dev/null; check test "$(kprop Rolling)" = false
CASE="TCP off the allow-list"
r=$(osc tcp 10.77.0.1 "$TCP_PORT" --from 10.88.0.5 --secret "$SECRET" /transport/play); sleep 0.2
echo "  TCP from 10.88.0.5 (not on the allow-list), right secret: replies $(jq -c .replies <<<"$r"), closed: $(jq .closed_by_server <<<"$r"); Rolling $(kprop Rolling)"
check jq -e '.closed_by_server and .replies == []' <<<"$r" >/dev/null; check test "$(kprop Rolling)" = false
busctl --user call "${K[@]}" Play  # Clock1.Tempo follows the published bar, which moves while rolling
sleep 0.2; t0=$(kprop Tempo)
CASE="UDP off the allow-list"
osc udp 10.77.0.1 "$RUDP_PORT" --from 10.88.0.5 /sec/count 1.0 >/dev/null; sleep 0.2
echo "  UDP from 10.88.0.5 (not allowed) /sec/count 1.0 (would be 180 BPM): Tempo $t0 -> $(kprop Tempo); $(st)"
check test "$(kprop Tempo)" = "$t0"
CASE="UDP allowed"
osc udp 10.77.0.1 "$RUDP_PORT" --from 10.77.0.2 /sec/count 0.25 >/dev/null; sleep 0.2
echo "  UDP from 10.77.0.2 (allowed) /sec/count 0.25: Tempo -> $(kprop Tempo)"
check test "$(kprop Tempo)" = 90
CASE="malformed"
m0=$(cprop Malformed | cut -d' ' -f1)
osc udp 10.77.0.1 "$RUDP_PORT" --from 10.77.0.2 --raw 2f7365632f636f756e7400002c6600 /x >/dev/null; sleep 0.2
echo "  UDP malformed packet (/sec/count with its float cut off): Tempo $(kprop Tempo); $(st)"
check test "$(kprop Tempo)" = 90; check test "$(cprop Malformed | cut -d' ' -f1)" = $((m0 + 1))
CASE="rate limit"
rx0=$(cprop Received | cut -d' ' -f1); rj0=$(cprop Rejected | cut -d' ' -f1)
sleep 1.1
osc udp 10.77.0.1 "$RUDP_PORT" --from 10.77.0.2 --count 2000 /sec/count 0.5 >/dev/null; sleep 0.5
rx1=$(cprop Received | cut -d' ' -f1); rj1=$(cprop Rejected | cut -d' ' -f1)
echo "  flood: 2000 messages at once to a 100 msg/s listener: accepted $((rx1 - rx0)), refused over the rate $((rj1 - rj0)), the other $((2000 - (rx1 - rx0) - (rj1 - rj0))) dropped by the kernel's socket buffer before controld read them"
check test $((rx1 - rx0)) -le 105
CASE="no management over OSC"
for p in /backline/map /backline/learn /backline/listen /backline/control/Map /backline/auth; do
  osc udp 127.0.0.1 "$UDP_PORT" "$p" "osc:/evil" "transport:play" >/dev/null
  osc tcp 10.77.0.1 "$TCP_PORT" --from 10.77.0.2 --secret "$SECRET" "$p" "osc:/evil" "transport:play" >/dev/null
done
sleep 0.3
echo "  OSC messages that look like management (/backline/map, /learn, /listen, ...): mappings $maps0 -> $(cprop MappingCount), listeners $(cprop Listeners | cut -d' ' -f1), learning '$(cprop Learning)'"
check test "$(cprop MappingCount)" = "$maps0"; check test "$(cprop Listeners | cut -d' ' -f1)" = "3"
busctl --user call "${K[@]}" Stop
CASE="blocked after 3 failures"
for i in 1 2 3; do osc tcp 10.77.0.1 "$TCP_PORT" --from 10.77.0.2 --secret "another-wrong-secret-$i-xxxxxxxx" /x >/dev/null; done
r=$(osc tcp 10.77.0.1 "$TCP_PORT" --from 10.77.0.2 --secret "$SECRET" /transport/play); sleep 0.2
echo "  3 wrong secrets in a row from 10.77.0.2, then the right one: replies $(jq -c .replies <<<"$r"), closed: $(jq .closed_by_server <<<"$r"), Rolling $(kprop Rolling) (the address is refused for 30 s); $(st)"
check jq -e '.closed_by_server and .replies == []' <<<"$r" >/dev/null; check test "$(kprop Rolling)" = false
CASE="another allowed peer"
r=$(osc tcp 10.77.0.1 "$TCP_PORT" --from 10.77.0.1 --secret "$SECRET" /transport/play); sleep 0.2
echo "  meanwhile another allowed address (10.77.0.1) with the secret: replies $(jq -c .replies <<<"$r"); Rolling $(kprop Rolling)"
check test "$(kprop Rolling)" = true
busctl --user call "${K[@]}" Stop
echo "  final: $(st)"
[[ ${#bad[@]} == 0 ]] && echo "  RESULT: PASS (10 cases: every refused input changed nothing, every allowed one took effect)" || echo "  RESULT: FAIL (${bad[*]})"

echo; echo "-- 7b. Save, restart from the file, exit"
ctl RemoveMapping s m1 >/dev/null 2>&1 || true
path=$(ctl Save | cut -d'"' -f2)
echo "  saved ${path#"$out"/}: mode $(stat -c %a "$path"), $(jq '.mappings | length' "$path") mappings, $(jq '.listeners | length' "$path") listeners (secret kept in the file: $(jq '[.listeners[] | has("secret")] | any' "$path"))"
before=$(cprop Listeners); mbefore=$(cprop MappingCount)
stop_controld
echo "  controld stopped; sockets now: '$(sockets)'"
start_controld --config-dir "$out/config"
mafter=$(cprop MappingCount); lafter=$(cprop Listeners)
echo "  restarted from the file: mappings $mbefore -> $mafter; listeners $(sed 's/:[0-9]*"/:PORT"/g' <<<"$lafter")"
s_run=$(sockets)
echo "  sockets now: '$s_run'"
stop_controld
s_end=$(sockets)
echo "  controld stopped; sockets now: '${s_end}'"
[[ $(stat -c %a "$path") == 600 && $mafter == "$mbefore" && $lafter == "$before" && -n $s_run && -z $s_end ]] &&
  echo "  RESULT: PASS (saved 0600 with its secret, restored the same mappings and listeners on the same ports, no socket after exit)" || echo "  RESULT: FAIL"
fi

