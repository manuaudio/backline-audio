echo "  ActiveProfiles after the save: $(cprop ActiveProfiles)"
stop_controld
# a new config dir: no control.json, so the only way the mapping comes back is the profile
start_controld --config-dir "$out/config8b" --profile-dir "$pdir"
wait_log "$out/controld.log" "on the session bus"
m0=$(cprop MappingCount)
v0=$(wpctl get-volume "$(pw-dump | jq -r '.[] | select(.info.props["node.name"]=="backline-test.ctl-vol") | .id')" 2>/dev/null || echo "?")
"$BL_BIN/backline-test-keyboard" --name backline-test-ctlkbd wait=1.5 cc=22,64 wait=1.0 >/dev/null 2>&1 &
