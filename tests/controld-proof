sleep 1.0
a1=$(cprop ActiveProfiles); m1=$(cprop MappingCount)
sleep 1.0
v1=$(wpctl get-volume "$(pw-dump | jq -r '.[] | select(.info.props["node.name"]=="backline-test.ctl-vol") | .id')" 2>/dev/null || echo "?")
jcall Mappings >"$out/mappings-p.json"
