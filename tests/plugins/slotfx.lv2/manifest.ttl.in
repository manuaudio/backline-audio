@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://github.com/manuaudio/backline-audio/test/slotfx>
	a lv2:Plugin ;
	lv2:binary <backline-test-slotfx@CMAKE_SHARED_MODULE_SUFFIX@> ;
	rdfs:seeAlso <slotfx.ttl> .

