$B note synth-vst3 on 69 100; $B note synth-lv2 on 69 100; sleep 1.2; $B note synth-vst3 off 69; $B note synth-lv2 off 69
wait $rec
eval_py "$t_kill" "$pv0" "$pl0" "$gate" <<'EOF'
import glob, json, math, sys
here, out, t_kill, pv0, pl0, gate = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4]), int(sys.argv[5]), sys.argv[6]
sys.path.insert(0, here)
import analyze as A
ev = [json.loads(l) for l in open(f"{out}/events.jsonl")]
res, ok = {}, gate == "ok"
for track, id_, pid0, moves in ((1, "synth-vst3", pv0, ("Global Volume", "A Pitch", "Send FX 1 Return")),
                                (2, "synth-lv2", pl0, ("Amplifier Gain", "Osc1 Semitones", "Filter1 Frequency"))):
    before = {p["id"]: p for p in json.load(open(f"{out}/params-before-{id_}.json"))}
    after = {p["id"]: p for p in json.load(open(f"{out}/params-after-{id_}.json"))}
    import struct
    f32 = lambda v: struct.unpack("f", struct.pack("f", v))[0]
    diff = [i for i in before if i not in after or before[i]["value"] != after[i]["value"]]
    diff32 = [i for i in before if i not in after or f32(before[i]["value"]) != f32(after[i]["value"])]
    crash = next(e for e in ev if e["event"] == "Crashed" and e["id"] == id_)
    rst = next(e for e in ev if e["event"] == "Restarted" and e["id"] == id_)
    ms = lambda t: (t - t_kill) / 1e6
    def note(name):
        w = A.read_wav(glob.glob(f"{out}/{name}-0{track}-*.wav")[0]); rate = w["rate"]; x = A.mono(w)
        on = next(i for i, v in enumerate(x) if abs(v) > 1e-3)
        seg = x[on + int(0.2 * rate): on + int(1.0 * rate)]
        return A.db(A.rms(seg)), A.f0(seg, rate)[0]
    (lb, fb), (la, fa) = note("state-before"), note("state-after")
    print(f"  {id_}: {len(before)} parameters before, {len(after)} after; values that differ: {len(diff)} (exact comparison), "
          f"{len(diff32)} at 32-bit float precision")
    for i in diff:
        print(f"    differs exactly: {before[i]['name']} {before[i]['value']!r} -> {after[i].get('value')!r} (the plugin keeps it as a 32-bit float)")
    for n in moves:
        b = next(p["value"] for p in before.values() if p["name"] == n); a = next(p["value"] for p in after.values() if p["name"] == n)
        print(f"    {n:18} before {b:.6g}  after {a:.6g}")
    print(f"    Crashed(signal {crash['signal']}) +{ms(crash['monotonic_ns']):.1f} ms, Restarted(pid {rst['pid']}, restarts {rst['restarts']}) +{ms(rst['monotonic_ns']):.1f} ms after the kill")
    print(f"    A4 before the kill {lb:.2f} dBFS, {fb:.2f} Hz | after the restart {la:.2f} dBFS, {fa:.2f} Hz ({la - lb:+.2f} dB, {1200 * math.log2(fa / fb):+.2f} cents)")
    good = (not diff32 and len(before) > 100 and crash["signal"] == 9 and rst["pid"] != pid0 and abs(la - lb) < 0.2
            and abs(1200 * math.log2(fa / fb)) < 2)
    res[id_] = {"params": len(before), "diffs": len(diff), "diffs_float32": len(diff32), "crashed_ms": ms(crash["monotonic_ns"]),
                "restarted_ms": ms(rst["monotonic_ns"]), "level_db": [lb, la], "f0": [fb, fa], "pass": good}
    ok = ok and good
print(f"  RESULT: {'PASS' if ok else 'FAIL'} (both formats come back with every parameter value and the same sound; the gate refuses a fail grade)")
json.dump(res | {"gate": gate, "pass": ok}, open(f"{out}/result-hostd.json", "w"), indent=1)
EOF
