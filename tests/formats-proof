wait $watch || true
running_new() { [[ $($B --json host show "$1" | jq -r '"\(.state) \(.pid)"') == "running "* ]] && [[ $($B --json host show "$1" | jq -r .pid) != "$2" ]]; }
wait_for "VST3 back" running_new synth-vst3 "$pv0"; wait_for "LV2 back" running_new synth-lv2 "$pl0"
