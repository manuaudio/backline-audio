declare -A MOVES=([synth-vst3]="Global Volume=0.5|A Pitch=0.6|Send FX 1 Return=0.25" [synth-lv2]="Amplifier Gain=0.6|Osc1 Semitones=0.6|Filter1 Frequency=0.3")
