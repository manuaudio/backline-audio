# D-Bus activation for the Backline clock service (session bus).
# Installed as /usr/share/dbus-1/services/io.github.manuaudio.Backline.Clock.service
# with @bindir@ replaced (CMake does this at install time).
# SPDX-License-Identifier: MIT
[D-BUS Service]
Name=io.github.manuaudio.Backline.Clock
Exec=@bindir@/backline-clockd --idle-exit 60
