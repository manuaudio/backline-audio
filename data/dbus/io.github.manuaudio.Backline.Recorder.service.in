# D-Bus activation for the Backline recorder service (session bus).
# Installed as /usr/share/dbus-1/services/io.github.manuaudio.Backline.Recorder.service
# with @bindir@ replaced (CMake does this at install time).
# SPDX-License-Identifier: MIT
[D-BUS Service]
Name=io.github.manuaudio.Backline.Recorder
Exec=@bindir@/backline-recorderd --idle-exit 60
