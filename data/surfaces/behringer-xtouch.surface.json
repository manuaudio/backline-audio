{
  "schema": "backline.surface/1",
  "id": "behringer-xtouch",
  "name": "Behringer X-Touch (MC mode)",
  "comment": "Port names, the serial in the device-query answer, the output pace and the printed labels are not verified on hardware yet: see docs/HARDWARE-TEST.md.",
  "verified": false,
  "driver": "mcu",
  "unit": "master",
  "strips": 8,
  "master-fader": true,
  "model": 20,
  "match": {
    "port": [
      "X-Touch"
    ],
    "exclude": [
      "Ext",
      "One",
      "Compact",
      "Mini"
    ]
  },
  "handshake": "mackie",
  "display": {
    "lcd": "2x56",
    "colour": "xtouch",
    "assignment": true,
    "timecode": true
  },
  "meters": "led",
  "touch-sense": true,
  "motor": true,
  "bytes-per-second": 12000,
  "labels": {
    "view-midi": "MIDI",
    "view-inputs": "INPUTS",
    "view-audio": "AUDIO",
    "view-instrument": "INST",
    "view-aux": "AUX",
    "view-buses": "BUSES",
    "view-outputs": "OUTPUTS",
    "view-user": "USER",
    "assign-instrument": "INST",
    "assign-pan": "PAN/SURROUND",
    "assign-plugin": "PLUG-IN",
    "alt": "ALT",
    "solo-clear": "SOLO",
    "forward": "FF"
  },
  "bindings": {
    "bank-left": "bank-left",
    "bank-right": "bank-right",
    "channel-left": "channel-left",
    "channel-right": "channel-right",
    "shift+bank-left": "bank-first",
    "shift+bank-right": "bank-last",
    "flip": "flip",
    "name-value": "name-value",
    "view-midi": "layer:1",
    "view-inputs": "layer:2",
    "view-audio": "layer:3",
    "view-instrument": "layer:4",
    "view-aux": "layer:5",
    "view-buses": "layer:6",
    "view-outputs": "layer:7",
    "view-user": "layer:8",
    "assign-track": "pot-mode:input",
    "assign-send": "pot-mode:send",
    "assign-pan": "pot-mode:pan",
    "assign-plugin": "pot-mode:inserts",
    "assign-eq": "pot-mode:eq",
    "assign-instrument": "pot-mode:dynamics"
  }
}
