# Maintainer: manuaudio <188948351+manuaudio@users.noreply.github.com>
# SPDX-License-Identifier: MIT
#
# Backline for Arch Linux, for the AUR (docs/AUR.md). Checked in a clean
# container with packaging/arch/container-check (which also checks that
# pkgver is the version in CMakeLists.txt's project()). On a release: tag
# v$pkgver, then updpkgsums and a new .SRCINFO. Before a tag exists,
# `container-check --local` builds this checkout's HEAD instead.
pkgname=backline-audio
pkgver=0.4.0
pkgrel=1
pkgdesc='Mac-style pro audio for PipeWire and Omarchy: plugin host (CLAP, VST3, LV2), plugin index, recorder, player, clock (LTC, MTC, Link), OSC/MIDI control, control surfaces'
arch=(x86_64 aarch64)
url='https://github.com/manuaudio/backline-audio'
# MIT for everything; backline-clockd is built with Ableton Link, which makes
# that one binary GPL-2.0-or-later (docs/DECISIONS.md D3)
license=('MIT' 'GPL-2.0-or-later')
depends=(
  avahi
  bash
  glibc
  json-c
  libgcc
  libltc
  libpipewire
  libsndfile
  libstdc++
  lilv
  openssl
  pipewire
  pipewire-jack
  systemd-libs
)
makedepends=(alsa-lib asio cmake ninja vst3sdk)
optdepends=('clap-validator: deeper validation of CLAP plugins in the registry'
            'jq: the omarchy-backline-* commands (an Omarchy default)'
            'python: omarchy-backline-setup, the menu rows and hotkeys (an Omarchy default)')
install=backline-audio.install
_link=4.1.1
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "ableton-link-$_link.tar.gz::https://github.com/Ableton/link/archive/refs/tags/Link-$_link.tar.gz")
sha256sums=('c7f023b68f472bd9bbf8ad7b5d4dfdf328c6ca295897a0884ef53fc3be02bd7d'
            '23983a87eecc550be849598acb5219fbf1a16a5b4266a50ba4471b4f6c34f4a4')

build() {
  cmake -S "$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBACKLINE_LINK_DIR="$srcdir/link-Link-$_link" \
    -Wno-dev
  cmake --build build
}

check() {
  # autolink starts a private PipeWire and WirePlumber; it is a developer
  # proof, not a build check (and a build chroot has no session for it).
  ctest --test-dir build --output-on-failure -E '^autolink$'
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/link-Link-$_link/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/ABLETON-LINK-LICENSE.md"
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" "$pkgname-$pkgver"/{README.md,ARCHITECTURE.md}
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname/api" "$pkgname-$pkgver"/docs/api/*.md
}
